# Public Supabase client config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paid Storage image transformations remain off until owner approval and project enablement.
VITE_PUBLIC_IMAGE_TRANSFORMS=false

# Server-side Supabase access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPT_BUCKET=receipts

# Admin seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_ROLE=admin

# App URLs
APP_URL=http://localhost:5173
# Origin used for everything rendered into HTML: canonicals, Open Graph, JSON-LD,
# robots and the sitemap. Must equal APP_URL - decision D-1 flips both together.
VITE_PUBLIC_SITE_ORIGIN=http://localhost:5173

# Public checkout stays disabled until every production activation gate in
# docs/donations-runbook.md has been approved and verified.
VITE_PUBLIC_DONATION_CHECKOUT_ENABLED=false

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Direct COD AlipayHK sandbox. These are server-only values; never expose them as VITE_* variables.
# Keep the base64-encoded key material empty in source control. Set COD_ENV=production only
# after the separate production activation review.
# COD_PRIVATE_KEY_BASE64 is the merchant private key. COD_NOTIFICATION_PUBLIC_KEY_BASE64 is
# the separate COD notification public key used to verify incoming notifications.
COD_ENV=sandbox
COD_MERCHANT_ID=
COD_SEGMENT_ID=
COD_AES_SECRET_BASE64=
COD_PRIVATE_KEY_BASE64=
COD_NOTIFICATION_PUBLIC_KEY_BASE64=

# HSBC PayMe for Business (API v0.12). Server-only: never expose these as VITE_* variables.
# Sandbox defaults are shown. Keep every secret empty in source control and set them only
# after the separate PayMe go-live review. For production, set PAYME_API_BASE to
# https://api.payme.hsbc.com.hk together with the production credentials HSBC issues after it
# accepts the sandbox test evidence; sandbox credentials do not work there. Keep sandbox values
# in Preview and local environments. See docs/donations-runbook.md, "PayMe: Sandbox to Production".
PAYME_API_BASE=https://sandbox.api.payme.hsbc.com.hk
PAYME_API_VERSION=0.12
PAYME_CLIENT_ID=
PAYME_CLIENT_SECRET=
PAYME_SIGNING_KEY_ID=
# Base64 signing key supplied during PayMe onboarding.
PAYME_SIGNING_KEY=
# PayCode lifetime in seconds; must be an integer >= 15.
PAYME_EFFECTIVE_DURATION=600

# Resend test mode/domain
RESEND_API_KEY=
# Server-only signing secret from the Resend webhook endpoint; never a VITE variable.
RESEND_WEBHOOK_SECRET=
DONATION_EMAIL_FROM=HKSCDA <noreply@hkscda.com>
DONATION_REPLY_TO=info@hkscda.com
NOTIFICATION_EMAIL=info@hkscda.com

# Receipt PDF metadata
RECEIPT_SIGNATORY_NAME=HKSCDA
RECEIPT_CHARITY_NAME=香港拯救貓狗協會有限公司
RECEIPT_FILE_NO=91/14493

# Rate limiting (Upstash Redis). Leave unset to disable limiting (dev/preview);
# the limiter fails open when these are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile CAPTCHA on the public donation + adoption forms.
# TURNSTILE_SECRET_KEY is server-only; VITE_TURNSTILE_SITE_KEY is public.
# Leave unset to disable (verification fails open when the secret is absent).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Browser-restricted Google Maps JavaScript API key for the public Stories map.
VITE_GOOGLE_MAPS_API_KEY=

# Guarded sponsorship outbox cron. Sending remains queued without RESEND_API_KEY.
# Configure an active staff/admin/treasurer auth user UUID for leased deliveries.
SPONSORSHIP_JOB_ACTOR_ID=

# Guarded volunteer hourly job. Configure the auth user UUID of an active admin
# (admin_user role admin, status active); without it every hourly run fails.
VOLUNTEER_JOB_ACTOR_ID=

# Bearer secret shared with guarded scheduled job endpoints. See docs/background-jobs-runbook.md.
CRON_SECRET=

# Server-only: activate only after hosted Auth, email sink verification and approval.
SUPPORTER_RECOVERY_ENABLED=false
# Server-only, 32 cryptographically random bytes encoded as canonical base64.
# Leave unset until separately approved activation; rotation invalidates outstanding codes.
SUPPORTER_RECOVERY_TOKEN_KEY=
